# CombustionLens Environment Variables Template
# Copy this file to .env and configure as needed.

# Optional: OpenAI API Key for generative grounded synthesis.
# If omitted or empty, CombustionLens uses fully deterministic grounded synthesis.
OPENAI_API_KEY=

# Optional: Comma-separated list of additional CORS origins for FastAPI.
# Default includes localhost:5173, localhost:3000, 127.0.0.1:7860
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Server port (Hugging Face Spaces Docker SDK defaults to 7860)
PORT=7860
